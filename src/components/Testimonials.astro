---
import depoimentos from '../data/depoimentos.json';
import { site, preenchido } from '../config/site';

const lista = depoimentos.filter((d) => preenchido(d.autor) && preenchido(d.texto));
const media = lista.length ? lista.reduce((s, d) => s + (d.nota || 0), 0) / lista.length : 0;
const google = site.redes.google;
---
{lista.length > 0 && (
  <section class="section section--alt" aria-labelledby="depoimentos-titulo">
    <div class="container">
      <div class="section-head">
        <h2 id="depoimentos-titulo" class="eyebrow">Depoimentos</h2>
        <hr class="rule" />
        <p class="depoimentos__resumo">
          <strong>{media.toFixed(1).replace('.', ',')}</strong> de 5 · {lista.length} {lista.length === 1 ? 'avaliação' : 'avaliações'}
          {preenchido(google) && <> no <a href={google} class="link-underline" target="_blank" rel="noopener">Google<span class="visually-hidden"> (abre em nova aba)</span></a></>}
        </p>
      </div>
      <div class="depoimentos__grid">
        {lista.map((d) => (
          <figure class="depoimento">
            <p class="depoimento__estrelas" role="img" aria-label={`Nota ${d.nota} de 5`}>
              <span aria-hidden="true">{'★'.repeat(d.nota)}<span class="depoimento__vazias">{'★'.repeat(5 - d.nota)}</span></span>
            </p>
            <blockquote class="depoimento__texto"><p>{d.texto}</p></blockquote>
            <figcaption class="depoimento__autor">
              {d.autor}{preenchido(d.fonte) && <span class="depoimento__fonte"> · {d.fonte}</span>}
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .depoimentos__resumo { color: var(--color-ink-soft); font-size: var(--text-sm); }
  .depoimentos__resumo strong { font-family: var(--font-display); font-size: var(--text-lg); color: var(--color-green); }
  .depoimentos__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr)); gap: var(--space-6); }
  .depoimento { padding: var(--space-8); background-color: var(--color-surface); border: 1px solid var(--color-line); }
  .depoimento__estrelas { letter-spacing: 0.15em; color: var(--color-accent-text); }
  .depoimento__vazias { color: var(--color-line); }
  .depoimento__texto { margin-top: var(--space-4); font-size: var(--text-sm); line-height: var(--leading-normal); }
  .depoimento__texto p::before { content: '“'; }
  .depoimento__texto p::after { content: '”'; }
  .depoimento__autor { margin-top: var(--space-4); padding-top: var(--space-4); border-top: 1px solid var(--color-line); font-size: var(--text-xs); text-transform: uppercase; letter-spacing: var(--tracking-label); color: var(--color-ink-soft); }
  .depoimento__fonte { text-transform: none; letter-spacing: normal; }
</style>
