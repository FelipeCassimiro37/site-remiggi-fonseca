---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Membro } from '../data/equipe';
import EmailLink from './EmailLink.astro';
import { preenchido } from '../config/site';
import { pessoaId } from '../lib/schema';

interface Props { membro: Membro }
const { membro: m } = Astro.props;

const fotos = import.meta.glob<{ default: ImageMetadata }>('../assets/equipe/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const foto = preenchido(m.foto) ? fotos[`../assets/equipe/${m.foto}`]?.default : undefined;
if (preenchido(m.foto) && !foto) {
  console.warn(`[equipe] Foto "${m.foto}" não encontrada em src/assets/equipe/.`);
}

const iniciais = preenchido(m.nome)
  ? m.nome.split(/\s+/).filter((p) => p.length > 2).map((p) => p[0]).slice(0, 2).join('').toUpperCase()
  : '—';
const bio = (m.bio ?? []).filter(preenchido);
const areas = (m.areasFoco ?? []).filter(preenchido);
const anchor = preenchido(m.nome) ? pessoaId(m).split('#')[1] : undefined;
const P = (v: string) => ({ 'pendente': !preenchido(v) });
---
<article class="membro" id={anchor}>
  <div class="membro__foto">
    {foto ? (
      <Picture
        src={foto}
        alt={`Retrato de ${m.nome}`}
        widths={[208, 416, 600]}
        sizes="(max-width: 40rem) 9rem, 13rem"
        formats={['avif', 'webp']}
        width={600}
        height={600}
        loading="lazy"
        decoding="async"
        fit="cover"
      />
    ) : (
      <span class="membro__iniciais" aria-hidden="true">{iniciais}</span>
    )}
  </div>
  <div class="membro__info">
    <p class:list={['eyebrow', P(m.cargo)]}>{m.cargo}</p>
    <h3 class:list={['membro__nome', P(m.nome)]}>{m.nome}</h3>
    <p class:list={['membro__registro', P(m.registro)]}>{m.registro}</p>
    <p class:list={['membro__formacao', P(m.formacao)]}>{m.formacao}</p>

    {bio.length > 0 && <div class="membro__bio">{bio.map((p) => <p>{p}</p>)}</div>}

    {areas.length > 0 && (
      <div class="membro__areas">
        <h4 class="eyebrow">Áreas de foco</h4>
        <ul class="lista-traco">{areas.map((a) => <li>{a}</li>)}</ul>
      </div>
    )}

    <div class="membro__links">
      {preenchido(m.email)
        ? <EmailLink email={m.email} origem="equipe" class="link-underline" />
        : <span class="pendente">{m.email}</span>}
      {preenchido(m.linkedin) && (
        <a href={m.linkedin} class="link-underline" target="_blank" rel="noopener">LinkedIn<span class="visually-hidden"> de {m.nome} (abre em nova aba)</span></a>
      )}
    </div>
  </div>
</article>

<style>
  .membro { display: grid; grid-template-columns: 13rem 1fr; gap: var(--space-8); align-items: start; }
  .membro__foto { width: 13rem; aspect-ratio: 1; overflow: hidden; border: 1px solid var(--color-line); background-color: var(--color-surface); }
  .membro__foto :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .membro__iniciais { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; font-family: var(--font-display); font-size: var(--text-3xl); letter-spacing: 0.05em; color: var(--color-accent-text); }
  .membro__info > * + * { margin-top: var(--space-2); }
  .membro__nome { font-size: var(--text-xl); }
  .membro__registro { font-size: var(--text-xs); letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-ink-soft); }
  .membro__formacao, .membro__bio { font-size: var(--text-sm); color: var(--color-ink-soft); }
  .membro__bio { margin-top: var(--space-4) !important; }
  .membro__bio p + p { margin-top: var(--space-3); }
  .membro__areas { margin-top: var(--space-4) !important; font-size: var(--text-sm); }
  .membro__areas .lista-traco { margin-top: var(--space-2); }
  .membro__links { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-6); margin-top: var(--space-4) !important; font-size: var(--text-sm); word-break: break-all; }
  @media (width <= 40rem) {
    .membro { grid-template-columns: 1fr; gap: var(--space-4); }
    .membro__foto { width: 9rem; }
  }
</style>
