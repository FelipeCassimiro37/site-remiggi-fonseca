---
import Logo from './Logo.astro';
import { navegacao } from '../lib/navegacao';

const atual = Astro.url.pathname;
const ativo = (href: string) => (href === '/' ? atual === '/' : atual.startsWith(href));
---
<header class="site-header">
  <div class="container container--wide site-header__inner">
    <a href="/" class="site-header__brand" aria-label="Remiggi & Fonseca — página inicial">
      <Logo />
    </a>
    <button
      class="site-header__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label="Abrir menu"
    >
      <span></span><span></span><span></span>
    </button>
    <nav id="site-nav" class="site-nav" aria-label="Principal">
      <ul class="site-nav__list">
        {navegacao.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={['site-nav__link', { 'is-active': ativo(item.href) }]}
              aria-current={ativo(item.href) ? 'page' : undefined}
            >
              {item.nome}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; background-color: var(--color-bg); border-bottom: 1px solid var(--color-green); }
  .site-header__inner { display: flex; align-items: center; justify-content: space-between; gap: var(--space-6); min-height: 5.25rem; }
  .site-header__brand { flex-shrink: 0; color: var(--color-green); font-size: 0.78rem; }
  .site-nav__list { display: flex; align-items: center; gap: var(--space-8); list-style: none; }
  .site-nav__link { font-size: var(--text-sm); letter-spacing: 0.04em; color: var(--color-ink); padding-block: var(--space-2); border-bottom: 1px solid transparent; transition: border-color var(--transition), color var(--transition); }
  .site-nav__link:hover, .site-nav__link.is-active { color: var(--color-green); border-color: var(--color-green); }
  .site-header__toggle { display: none; flex-direction: column; justify-content: center; gap: 5px; width: 2.75rem; height: 2.75rem; border: 1px solid var(--color-line); border-radius: var(--radius); background: none; cursor: pointer; }
  .site-header__toggle span { display: block; width: 1.1rem; height: 1px; margin-inline: auto; background-color: var(--color-green); transition: transform var(--transition), opacity var(--transition); }

  @media (width <= 52rem) {
    .site-header__toggle { display: flex; }
    .site-nav { position: absolute; inset: 100% 0 auto; background-color: var(--color-bg); border-bottom: 1px solid var(--color-line); display: none; }
    .site-nav.is-open { display: block; }
    .site-nav__list { flex-direction: column; align-items: stretch; gap: 0; padding: var(--space-2) var(--page-padding) var(--space-6); }
    .site-nav__link { display: block; padding-block: var(--space-4); border-bottom: 1px solid var(--color-line); }
    .site-nav__link:hover, .site-nav__link.is-active { border-color: var(--color-line); }
    .site-header__toggle[aria-expanded='true'] span:first-child { transform: translateY(6px) rotate(45deg); }
    .site-header__toggle[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
    .site-header__toggle[aria-expanded='true'] span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }
  }
</style>
