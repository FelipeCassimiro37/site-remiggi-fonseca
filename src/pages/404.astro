---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout titulo="Página não encontrada" descricao="A página procurada não existe ou foi movida." noindex>
  <header class="page-header">
    <div class="container container--prose">
      <p class="eyebrow">Erro 404</p>
      <hr class="rule" />
      <h1>Página não encontrada.</h1>
      <hr class="rule" />
      <p class="lead">O endereço pode ter mudado. Use o menu acima ou volte para a <a href="/" class="link-underline">página inicial</a>.</p>
    </div>
  </header>
</BaseLayout>
