---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CookieBanner from '../components/CookieBanner.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import { site, preenchido, urlAbsoluta } from '../config/site';
import { grafo, breadcrumb, type Migalha } from '../lib/schema';

// Fontes servidas pelo próprio site, apenas nos subconjuntos latinos.
import serifLatin from '@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-normal.woff2?url';
import serifLatinExt from '@fontsource-variable/source-serif-4/files/source-serif-4-latin-ext-wght-normal.woff2?url';
import corm500 from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-500-normal.woff2?url';
import corm500Ext from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-ext-500-normal.woff2?url';
import corm600 from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-600-normal.woff2?url';
import corm600Ext from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-ext-600-normal.woff2?url';

interface Props {
  /** Título da página (sem o nome do escritório). Omitir na página inicial. */
  titulo?: string;
  /** Descrição única da página para buscadores (até ~155 caracteres). */
  descricao: string;
  /** Migalhas de pão, sem incluir "Início" (adicionado automaticamente). */
  migalhas?: Migalha[];
  /** Nós extras de dados estruturados (FAQPage, Person, Service...). */
  schema?: object[];
  /** Impede indexação (ex.: página 404). */
  noindex?: boolean;
}

const { titulo, descricao, migalhas = [], schema = [], noindex = false } = Astro.props;

const tituloCompleto = titulo ? `${titulo} · ${site.nomeCompleto}` : site.nomeCompleto;
const canonica = urlAbsoluta(Astro.url.pathname);
const ogImagem = urlAbsoluta('/og-default.png');

const trilha: Migalha[] = migalhas.length ? [{ nome: 'Início', caminho: '/' }, ...migalhas] : [];
const jsonLd = grafo(...(trilha.length ? [breadcrumb(trilha)] : []), ...schema);

const configCliente = {
  ga4Id: preenchido(site.integracoes.ga4Id) ? site.integracoes.ga4Id : null,
  web3formsKey: preenchido(site.integracoes.web3formsKey) ? site.integracoes.web3formsKey : null,
  whatsapp: preenchido(site.contato.whatsapp) ? site.contato.whatsapp : null,
  nomeSite: site.nomeCompleto,
};

const LATIN = 'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const LATIN_EXT = 'U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF';
const fontes = `
@font-face{font-family:'Source Serif 4 Variable';font-style:normal;font-display:swap;font-weight:200 900;src:url(${serifLatin}) format('woff2-variations');unicode-range:${LATIN}}
@font-face{font-family:'Source Serif 4 Variable';font-style:normal;font-display:swap;font-weight:200 900;src:url(${serifLatinExt}) format('woff2-variations');unicode-range:${LATIN_EXT}}
@font-face{font-family:'Cormorant Garamond';font-style:normal;font-display:swap;font-weight:500;src:url(${corm500}) format('woff2');unicode-range:${LATIN}}
@font-face{font-family:'Cormorant Garamond';font-style:normal;font-display:swap;font-weight:500;src:url(${corm500Ext}) format('woff2');unicode-range:${LATIN_EXT}}
@font-face{font-family:'Cormorant Garamond';font-style:normal;font-display:swap;font-weight:600;src:url(${corm600}) format('woff2');unicode-range:${LATIN}}
@font-face{font-family:'Cormorant Garamond';font-style:normal;font-display:swap;font-weight:600;src:url(${corm600Ext}) format('woff2');unicode-range:${LATIN_EXT}}`;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descricao} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonica} />}
    <meta name="theme-color" content="#2e3d2c" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preload" href={serifLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={corm500} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontes}></style>

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={site.nomeCompleto} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={ogImagem} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.nomeCompleto} — advocacia tributária, cível, trabalhista e contratual`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={tituloCompleto} />
    <meta name="twitter:description" content={descricao} />
    <meta name="twitter:image" content={ogImagem} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script type="application/json" id="config-site" set:html={JSON.stringify(configCliente)} />
  </head>
  <body>
    <a href="#conteudo" class="skip-link">Pular para o conteúdo</a>
    <Header />
    {trilha.length > 0 && <Breadcrumbs itens={trilha} />}
    <main id="conteudo" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <FloatingWhatsApp />
    <CookieBanner />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    left: var(--space-4);
    top: -10rem;
    z-index: 100;
    padding: var(--space-3) var(--space-6);
    background-color: var(--color-green);
    color: #fff;
    font-size: var(--text-sm);
  }
  .skip-link:focus { top: var(--space-4); }
  main:focus { outline: none; }
</style>
